	partition 'ZIP Monthly History' = m
		mode: import
		source =
				let
				  Source = PostgreSQL.Database("localhost:5432", "estateflow"),
				  #"Navigation 1" = Source{[Schema = "marts", Item = "zip_month_market_metrics"]}[Data]
				in
				  #"Navigation 1"

	changedProperty = Name

	annotation PBI_ResultType = Table

	measure 'Matched ZIPs in Month' = DISTINCTCOUNT('ZIP Monthly History'[zip_code])
		formatString: #,0
		displayFolder: Dashboard finish
		lineageTag: 088dde4e-2d1b-5816-ba3d-8ef255d2f1bb

	measure 'ZIP Home History' = IF(HASONEVALUE('Latest ZIP Market'[ZIP Code]), [Median Home Value Trend])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Dashboard finish
		lineageTag: 5b99848d-4a90-58e5-bb21-35f302b5e2c6

	measure 'ZIP Rent History' = IF(HASONEVALUE('Latest ZIP Market'[ZIP Code]), [Median Rent Trend])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Dashboard finish
		lineageTag: 60f3f9af-f255-53dd-9dc2-a7427772d60f
