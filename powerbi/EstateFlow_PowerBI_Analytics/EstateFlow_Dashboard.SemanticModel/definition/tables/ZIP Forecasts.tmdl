table 'ZIP Forecasts'
	lineageTag: 5747d9a7-86e2-4d97-a989-3fe88c2e04df

	measure 'Eligible ZIPs' = DISTINCTCOUNT('ZIP Forecasts'[ZIP Code])
		formatString: #,0
		lineageTag: a805f2c8-d331-4c69-a789-041b7f223acd

	measure 'Forecast As-Of Month' = MAX('ZIP Forecasts'[As-Of Month])
		formatString: mmmm yyyy
		lineageTag: b90a161f-f776-4dbd-9648-3a9af09e4b53

	measure 'Home Projection' =
			IF(
			    HASONEVALUE('ZIP Forecasts'[ZIP Code]),
			    CALCULATE(SELECTEDVALUE('ZIP Forecasts'[Projection]), 'ZIP Forecasts'[Index] = "Home value index")
			)
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 6a0f88c2-4472-46d1-8693-5c3f1ca47bd3

	measure 'Home 80% Lower' =
			IF(
			    HASONEVALUE('ZIP Forecasts'[ZIP Code]),
			    CALCULATE(SELECTEDVALUE('ZIP Forecasts'[80% Lower]), 'ZIP Forecasts'[Index] = "Home value index")
			)
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: bcf48dbe-6ced-42a6-b547-757bf6aa1a6c

	measure 'Home 80% Upper' =
			IF(
			    HASONEVALUE('ZIP Forecasts'[ZIP Code]),
			    CALCULATE(SELECTEDVALUE('ZIP Forecasts'[80% Upper]), 'ZIP Forecasts'[Index] = "Home value index")
			)
