		lineageTag: f572662f-86d6-423a-a5f7-30350ec49073

	measure 'Rent Projection' =
			IF(
			    HASONEVALUE('ZIP Forecasts'[ZIP Code]),
			    CALCULATE(SELECTEDVALUE('ZIP Forecasts'[Projection]), 'ZIP Forecasts'[Index] = "Monthly rent index")
			)
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: b407deaa-54b6-49d2-9323-a80692572b9b

	measure 'Rent 80% Lower' =
			IF(
			    HASONEVALUE('ZIP Forecasts'[ZIP Code]),
