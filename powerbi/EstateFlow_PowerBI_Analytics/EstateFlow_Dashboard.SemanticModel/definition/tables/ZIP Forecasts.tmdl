			)
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 8b32e219-e125-4bba-ae99-e1dfe1e1c7bd

	measure 'Rent 80% Upper' =
			IF(
			    HASONEVALUE('ZIP Forecasts'[ZIP Code]),
			    CALCULATE(SELECTEDVALUE('ZIP Forecasts'[80% Upper]), 'ZIP Forecasts'[Index] = "Monthly rent index")
