table 'Latest ZIP Market'
	lineageTag: 87b46ff2-db72-4020-8b98-234acca8e547

	measure 'Latest ZIP Count' =
			
			DISTINCTCOUNT('Latest ZIP Market'[ZIP Code])
		formatString: #,0
		displayFolder: Core KPIs
		lineageTag: 345977d6-6aae-4ebf-941b-febc0a273c5c

	measure 'Median Home Value' =
			
			MEDIAN('Latest ZIP Market'[Home Value])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Core KPIs
		lineageTag: 46989e7c-4da8-41e4-b5e5-febd03cfce98

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Median Monthly Rent' =
			
			MEDIAN('Latest ZIP Market'[Monthly Rent])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Core KPIs
		lineageTag: 0cace5d9-58c8-45be-9766-efe5aa82086a

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Median Gross Rent-to-Value' =
			
			DIVIDE(
			    MEDIAN('Latest ZIP Market'[Gross Yield %]),
			    100
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Core KPIs
		lineageTag: f8fb3432-2367-448e-93dc-318ac87a9a6a

	measure 'Latest Data Month' =
			
			MAX('Latest ZIP Market'[Month])
		formatString: mmmm yyyy
		displayFolder: Core KPIs
		lineageTag: 2db6ae7c-d130-4ff1-90d9-505264adc811

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	measure 'Median Home Value YoY' =
			
			DIVIDE(
			    MEDIAN('Latest ZIP Market'[home_value_yoy_pct]),
			    100
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Market Growth
		lineageTag: 59824e62-9a9c-4fcb-8e96-9bf03fe9253e

	measure 'Median Rent YoY' =
			
			DIVIDE(
			    MEDIAN('Latest ZIP Market'[rent_yoy_pct]),
			    100
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Market Growth
		lineageTag: d936b56c-91d4-4b70-8a43-34294a44b727

	measure 'YoY Coverage' =
			
			DIVIDE(
			    CALCULATE(
			        COUNTROWS('Latest ZIP Market'),
			        'Latest ZIP Market'[has_yoy_comparison] = TRUE()
			    ),
			    COUNTROWS('Latest ZIP Market')
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Market Growth
		lineageTag: b150a796-d365-4f21-a8c7-9b2261ec212b

