  "name": "e104f205a306b407c508",
  "position": { "x": 48, "y": 550, "z": 3, "height": 474, "width": 850, "tabOrder": 3 },
  "visual": {
    "visualType": "textbox",
    "objects": { "general": [{ "properties": { "paragraphs": [
      { "textRuns": [{ "value": "WHAT TO LOOK FOR", "textStyle": { "fontFamily": "Georgia", "fontSize": "18pt", "color": "#F3EEE4" } }], "horizontalTextAlignment": "left" },
      { "textRuns": [{ "value": "BALANCE, NOT ONE WINNING NUMBER", "textStyle": { "fontFamily": "Segoe UI Semibold", "fontSize": "10pt", "color": "#D8C398" } }], "horizontalTextAlignment": "left" },
      { "textRuns": [{ "value": "A compelling market usually combines reasonable yield, stable or improving rents, and sustainable home-value movement. The highest yield alone can indicate greater risk.", "textStyle": { "fontFamily": "Segoe UI", "fontSize": "10pt", "color": "#AAA49A" } }], "horizontalTextAlignment": "left" },
      { "textRuns": [{ "value": "DIVERGENCE BETWEEN RENT AND VALUE", "textStyle": { "fontFamily": "Segoe UI Semibold", "fontSize": "10pt", "color": "#D8C398" } }], "horizontalTextAlignment": "left" },
      { "textRuns": [{ "value": "When rents grow faster than home values, gross yield may improve. When values rise faster than rents, yield may compress even while owners gain appreciation.", "textStyle": { "fontFamily": "Segoe UI", "fontSize": "10pt", "color": "#AAA49A" } }], "horizontalTextAlignment": "left" },
      { "textRuns": [{ "value": "CONSISTENCY OVER TIME", "textStyle": { "fontFamily": "Segoe UI Semibold", "fontSize": "10pt", "color": "#D8C398" } }], "horizontalTextAlignment": "left" },
      { "textRuns": [{ "value": "Use the historical chart to distinguish a durable trend from a single-month spike. Smooth, sustained movement is generally more informative than one unusual observation.", "textStyle": { "fontFamily": "Segoe UI", "fontSize": "10pt", "color": "#AAA49A" } }], "horizontalTextAlignment": "left" },
      { "textRuns": [{ "value": "DATA COVERAGE", "textStyle": { "fontFamily": "Segoe UI Semibold", "fontSize": "10pt", "color": "#D8C398" } }], "horizontalTextAlignment": "left" },
      { "textRuns": [{ "value": "Check ZIP Count and YoY Coverage before drawing conclusions. Filters can reduce the sample, and not every ZIP has a complete history.", "textStyle": { "fontFamily": "Segoe UI", "fontSize": "10pt", "color": "#AAA49A" } }], "horizontalTextAlignment": "left" },
      { "textRuns": [{ "value": "A PRACTICAL SCREENING SEQUENCE", "textStyle": { "fontFamily": "Segoe UI Semibold", "fontSize": "10pt", "color": "#D8C398" } }], "horizontalTextAlignment": "left" },
      { "textRuns": [{ "value": "Filter a target market → shortlist ZIP codes with credible yield → compare rent and value growth → investigate vacancies, taxes, insurance, expenses and neighbourhood conditions outside this dashboard.", "textStyle": { "fontFamily": "Segoe UI", "fontSize": "10pt", "color": "#AAA49A" } }], "horizontalTextAlignment": "left" }
    ] } }] },
